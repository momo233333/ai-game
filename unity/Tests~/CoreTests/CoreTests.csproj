<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>CoreTests</AssemblyName>
    <RootNamespace>Copilot.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="TestFramework.cs" />
    <Compile Include="CoreUnitTests.cs" />
    <Compile Include="ServerIntegrationTests.cs" />
  </ItemGroup>

</Project>
